# Never commit credentials. Production should use an attached Cloud Run/Functions service account via ADC.
GOOGLE_CALENDAR_ID=your-calendar-id
# Optional Google Sheet ID and A1 range, for example Bookings!A:K
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Bookings!A:K
# Mirror the Google Appointment Schedule here. Days are 0=Sunday through 6=Saturday.
# Multiple windows per day and date-specific overrides are supported. An empty override closes that date.
BOOKING_SCHEDULE_JSON={"timeZone":"America/New_York","slotIntervalMinutes":30,"bufferBeforeMinutes":0,"bufferAfterMinutes":0,"minimumAdvanceNoticeMinutes":120,"maximumAdvanceBookingDays":60,"closedWeekdays":[0,1,2],"unavailableDates":[],"weeklyAvailability":{"0":[],"1":[],"2":[],"3":[["09:00","18:00"]],"4":[["09:00","18:00"]],"5":[["09:00","18:00"]],"6":[["08:00","18:00"]]},"dateOverrides":{},"serviceDurations":{"balayage":210,"highlights":180,"haircut":60,"color":120,"styling":60,"consultation":30}}
ALLOWED_ORIGIN=https://gladys-cosmetology-studio.rapino.chatgpt.site
